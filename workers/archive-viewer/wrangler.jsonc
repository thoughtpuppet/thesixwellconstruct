{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sixwell-archive-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "archive-viewer.thesixwellconstruct.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "swc-submissions",
      "database_id": "ec619569-212f-43b7-9b8c-6ac3bfed85e5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUBMISSION_FILES",
      "bucket_name": "swc-submission-files"
    }
  ]
}
