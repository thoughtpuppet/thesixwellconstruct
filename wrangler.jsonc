{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thesixwellconstruct",
  "main": "_worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-04-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "swc-submissions",
      "database_id": "ec619569-212f-43b7-9b8c-6ac3bfed85e5"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "SITE_ANALYTICS",
      "dataset": "swc_site_analytics"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUBMISSION_FILES",
      "bucket_name": "swc-submission-files"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://thesixwellconstruct.com",
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_WEBHOOK_NOTIFICATION_URL": "https://thesixwellconstruct.com/api/square/webhook",
    "SQUARE_EVENTS_WEBHOOK_NOTIFICATION_URL": "https://thesixwellconstruct.com/api/square-events/webhook",
    "SQUARE_STUDIO_WEBHOOK_NOTIFICATION_URL": "https://thesixwellconstruct.com/api/square-studio/webhook",
    "NOTIFICATION_FROM_EMAIL": "saisolehman@artpilltattoohouse.com",
    "NOTIFICATION_FROM_NAME": "art.pill TATTOO HOUSE",
    "NOTIFICATION_REPLY_TO": "saisolehman@artpilltattoohouse.com",
    "ADMIN_NOTIFICATION_EMAIL": "saisolehman@artpilltattoohouse.com",
    "ADMIN_NOTIFICATION_FROM_EMAIL": "notifications@artpilltattoohouse.com",
    "ADMIN_NOTIFICATION_FROM_NAME": "art.pill notifications",
    "STUDIO_CALENDAR_LOCATION": "364 Nelson Street SW, Atlanta, GA 30313",
    "STUDIO_CONTACT_PHONE": "(770) 820-5800",
    "SHOPIFY_STORE_DOMAIN": "six-well-2.myshopify.com",
    "SHOPIFY_STOREFRONT_API_VERSION": "2025-07",
    "SHOPIFY_MERCH_QUERY": "tag:construct-merch",
    "OUTREACH_CONSENT_SYNC_ENABLED": "false",
    "OUTREACH_PREFERENCES_ENABLED": "false",
    "OUTREACH_INDIVIDUAL_EMAIL_ENABLED": "false",
    "OUTREACH_INDIVIDUAL_SMS_ENABLED": "false",
    "OUTREACH_EMAIL_CAMPAIGNS_ENABLED": "false",
    "OUTREACH_SMS_CAMPAIGNS_ENABLED": "false"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
