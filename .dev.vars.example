SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_STOREFRONT_API_VERSION=2025-07
SHOPIFY_MERCH_QUERY=tag:construct-merch
# Keep every Merch delivery flag false until the local schema, verified sender,
# and Beehiiv double-opt-in webhook have been tested deliberately.
MERCH_ALERTS_ENABLED=false
MERCH_EMAIL_SEND_ENABLED=false
MERCH_LAUNCH_SEND_ENABLED=false
MERCH_FROM_EMAIL=notifications@your-verified-domain.example
MERCH_FROM_NAME=Six.Well Merch
MERCH_REPLY_TO=reply@your-verified-domain.example
# Construct People reads completed orders and customers through a Shopify
# custom app. Keep this Admin token secret and grant read_orders,
# read_all_orders, and read_customers.
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-your-shopify-admin-access-token
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=replace-with-your-shopify-webhook-secret
BEEHIIV_API_KEY=replace-with-your-beehiiv-api-key
BEEHIIV_PUBLICATION_IDS=replace-with-one-or-more-comma-separated-publication-ids
# Outreach uses one Beehiiv publication and an optional newsletter list.
BEEHIIV_OUTREACH_PUBLICATION_ID=replace-with-your-outreach-publication-id
BEEHIIV_OUTREACH_LIST_ID=replace-with-your-outreach-list-id
BEEHIIV_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
# Keep all delivery flags false through schema rollout and owner-only testing.
OUTREACH_CONSENT_SYNC_ENABLED=false
OUTREACH_PREFERENCES_ENABLED=false
OUTREACH_INDIVIDUAL_EMAIL_ENABLED=false
OUTREACH_EMAIL_CAMPAIGNS_ENABLED=false
SUBMISSIONS_ADMIN_TOKEN=replace-with-a-long-private-token
# Studio site analytics reads the existing Cloudflare Web Analytics RUM data
# and the custom swc_site_analytics Analytics Engine dataset with one narrowly
# scoped Account Analytics Read token. The site tag is the public token already
# present in Cloudflare's automatically injected Web Analytics beacon.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=replace-with-your-web-analytics-site-tag
CLOUDFLARE_ANALYTICS_API_TOKEN=replace-with-an-account-analytics-read-token
SQUARE_ACCESS_TOKEN=replace-with-your-square-access-token
SQUARE_LOCATION_ID=replace-with-your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_NOTIFICATION_URL=https://thesixwellconstruct.com/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-your-square-webhook-signature-key
# Studio bookings (open visits / gatherings / external rentals): dedicated
# Square location + webhook (own bank/EIN), same SQUARE_ACCESS_TOKEN as above.
SQUARE_STUDIO_LOCATION_ID=replace-with-your-studio-square-location-id
SQUARE_STUDIO_WEBHOOK_NOTIFICATION_URL=https://thesixwellconstruct.com/api/square-studio/webhook
SQUARE_STUDIO_WEBHOOK_SIGNATURE_KEY=replace-with-your-studio-square-webhook-signature-key
# Events use their own Square location and signed webhook.
SQUARE_EVENTS_LOCATION_ID=replace-with-your-events-square-location-id
SQUARE_EVENTS_WEBHOOK_NOTIFICATION_URL=https://thesixwellconstruct.com/api/square-events/webhook
SQUARE_EVENTS_WEBHOOK_SIGNATURE_KEY=replace-with-your-events-square-webhook-signature-key
STUDIO_CALENDAR_LOCATION=364 Nelson Street SW, Atlanta, GA 30313
STUDIO_CONTACT_PHONE=(770) 820-5800
ZOOM_ACCOUNT_ID=replace-with-your-zoom-account-id
ZOOM_CLIENT_ID=replace-with-your-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-your-zoom-client-secret
ZOOM_HOST_USER_ID=replace-with-your-zoom-host-user-id-or-email
